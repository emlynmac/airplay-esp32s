if DAC_WM8711BL

    config DAC_WM8711BL_MAX_VOLUME
        int "Maximum DAC volume (dB)"
        range -73 6
        default 0
        help
            Maximum headphone output level in dB that corresponds to
            AirPlay volume 0 dB.  The WM8711BL register range is
            -73 dB to +6 dB (0 dB is the codec's unity-gain reference).
            A value of 0 means AirPlay full volume maps to the DAC's
            0 dB output level.

endif # DAC_WM8711BL
