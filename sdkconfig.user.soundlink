# Soundlink button GPIOs (active-low, set to -1 to disable)
CONFIG_BTN_PLAY_PAUSE_GPIO=21
CONFIG_BTN_VOLUME_UP_GPIO=23
CONFIG_BTN_VOLUME_DOWN_GPIO=4
CONFIG_BTN_NEXT_GPIO=22
CONFIG_BTN_PREV_GPIO=18

# Display (I2C OLED, SSD1306 128x32)
CONFIG_DISPLAY_ENABLED=y
CONFIG_DISPLAY_HEIGHT_32=y
CONFIG_DISPLAY_BUS_I2C=y
CONFIG_DISPLAY_I2C_SDA=3
CONFIG_DISPLAY_I2C_SCL=1
CONFIG_DISPLAY_FLIP=y

# CONFIG_AIRPLAY_FORCE_V1=y
CONFIG_BT_PIN_CODE="0503"
CONFIG_TAS57XX_MAX_VOLUME=-12

# Logging
# CONFIG_LOG_DEFAULT_LEVEL_INFO is not set
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
